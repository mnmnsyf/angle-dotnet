{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ANGLE_ROOT": "${sourceDir}/external/angle"
      }
    },
    {
      "name": "vs2022-release",
      "displayName": "VS2022 x64 Release (ANGLE Release)",
      "inherits": "vs2022-base",
      "cacheVariables": {
        "ANGLE_OUT": "${sourceDir}/external/angle/out/Release"
      }
    },
    {
      "name": "vs2022-debug",
      "displayName": "VS2022 x64 Debug (ANGLE Debug)",
      "inherits": "vs2022-base",
      "cacheVariables": {
        "ANGLE_OUT": "${sourceDir}/external/angle/out/Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-release",
      "displayName": "Build Release",
      "configurePreset": "vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug"
    }
  ]
}
